# Public configuration only. Never put passwords, keys or tokens in these files: Vite bundles them into the browser app.

# false = call the real Claims API on Cloud Run. true = built-in sample data, no backend needed.
VITE_USE_MOCK=false

# Origin of the Claims API (do not add /api, the paths already include it). Empty = same origin as the app.
VITE_API_BASE_URL=https://insureguard-api-1097867841772.us-west1.run.app

# Leave empty: the backend has no WebSocket yet, so the app polls claim status over REST.
# Set to wss://... once a WebSocket endpoint exists.
VITE_WS_URL=

# Dev-only, same-origin setups: proxy /api to this target (leave VITE_API_BASE_URL empty when using it).
# VITE_DEV_API_TARGET=http://localhost:8080
