# Claim worker configuration. Copy to .env for local runs; on Cloud Run set these as env vars / Secret Manager secrets.

PORT=8080

# PostgreSQL (Cloud SQL), schema "insureguard"
DB_HOST=
DB_PORT=5432
DB_NAME=insureguard
DB_USER=insureguard_app
DB_PASSWORD=

# Redis (Memorystore)
REDIS_HOST=
REDIS_PORT=6379

# Cloud Storage bucket holding the uploaded claim documents
GCS_BUCKET=

# Document AI (OCR of uploaded documents). The processor id is required.
DOCUMENT_AI_PROJECT=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

# Vertex AI fraud model endpoint (ml_score). If the call fails the worker falls back to rules only.
GOOGLE_CLOUD_PROJECT=
VERTEX_REGION=us-west1
VERTEX_ENDPOINT_ID=
