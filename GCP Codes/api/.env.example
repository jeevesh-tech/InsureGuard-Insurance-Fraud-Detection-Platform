# Claims API configuration. Copy to .env for local runs; on Cloud Run set these as env vars / Secret Manager secrets.

PORT=8080

# PostgreSQL (Cloud SQL), schema "insureguard"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insureguard
DB_USER=insureguard_app
DB_PASSWORD=
DB_POOL_MAX=10
DB_SSL=false

# Redis (Memorystore)
REDIS_HOST=
REDIS_PORT=6379

# Pub/Sub topic that triggers the claim worker
CLAIM_EVENTS_TOPIC=insureguard-claim-events

# Cloud Storage bucket for claim photos / PDFs
GCS_BUCKET=

# Comma-separated list of allowed browser origins. Empty = allow any origin (development only).
FRONTEND_ORIGIN=http://localhost:5173
